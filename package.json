    "lint": "eslint",
    "extract": "node scripts/extract-html-parts.mjs",
    "posts:index": "node scripts/build-post-index.mjs",
    "categories:index": "node scripts/build-category-index.mjs",
    "tags:index": "node scripts/build-tag-index.mjs",
    "pages:index": "node scripts/build-pages-index.mjs",
    "authors:index": "node scripts/build-author-index.mjs",
    "archives:index": "node scripts/build-date-archive-index.mjs",
    "assets:sync": "node scripts/sync-uploads.mjs",
