# nerio-next — environment variables
#
# REQUIRED: none
# The app uses static JSON (data/) and legacy HTML (content/) with no secrets.
# `npm run dev` and `npm run build` work with an empty .env file.
#
# Copy to .env and adjust optional values:
#   copy .env.example .env

# -----------------------------------------------------------------------------
# Optional — site URL (for deployment / future metadata & API use)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional — dev server port (Next.js reads this automatically)
# -----------------------------------------------------------------------------
# PORT=3000

# -----------------------------------------------------------------------------
# Optional — future backend (not wired yet; lib/api.ts uses JSON files)
# -----------------------------------------------------------------------------
# API_BASE_URL=
# WP_REST_URL=
